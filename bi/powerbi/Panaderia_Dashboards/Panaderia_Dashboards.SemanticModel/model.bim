          },
          {
            "name": "fecha_key",
            "dataType": "int64",
            "sourceColumn": "fecha_key",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Hora",
            "dataType": "int64",
            "sourceColumn": "Hora",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "producto_key",
            "dataType": "int64",
            "sourceColumn": "producto_key",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "cliente_key",
            "dataType": "int64",
            "sourceColumn": "cliente_key",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "metodo_pago_key",
            "dataType": "int64",
            "sourceColumn": "metodo_pago_key",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "TipoComprobante",
            "dataType": "string",
            "sourceColumn": "TipoComprobante",
            "summarizeBy": "none"
          },
          {
            "name": "Estado",
            "dataType": "string",
            "sourceColumn": "Estado",
            "summarizeBy": "none"
          },
          {
            "name": "Cantidad",
            "dataType": "double",
            "sourceColumn": "Cantidad",
            "summarizeBy": "sum",
            "formatString": "#,0.###"
          },
          {
            "name": "PrecioUnitario",
            "dataType": "decimal",
            "sourceColumn": "PrecioUnitario",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0.00"
          },
          {
            "name": "Descuento",
            "dataType": "decimal",
            "sourceColumn": "Descuento",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0.00"
          },
          {
            "name": "Importe",
            "dataType": "decimal",
            "sourceColumn": "Importe",
            "summarizeBy": "none",
            "formatString": "\"S/ \"#,0.00",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Ventas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    T = Origen{[Schema=\"dw\",Item=\"fact_ventas\"]}[Data],",
                "    Sel = Table.SelectColumns(T, {\"item_venta_id\", \"venta_id\", \"fecha_key\", \"hora\", \"producto_key\", \"cliente_key\", \"metodo_pago_key\", \"tipo_comprobante\", \"estado\", \"cantidad\", \"precio_unitario\", \"descuento\", \"importe\"}),",
                "    Ren = Table.RenameColumns(Sel, {{\"hora\",\"Hora\"}, {\"tipo_comprobante\",\"TipoComprobante\"}, {\"estado\",\"Estado\"}, {\"cantidad\",\"Cantidad\"}, {\"precio_unitario\",\"PrecioUnitario\"}, {\"descuento\",\"Descuento\"}, {\"importe\",\"Importe\"}}),",
                "    Tipos = Table.TransformColumnTypes(Ren, {{\"item_venta_id\", Int64.Type}, {\"venta_id\", Int64.Type}, {\"fecha_key\", Int64.Type}, {\"Hora\", Int64.Type}, {\"producto_key\", Int64.Type}, {\"cliente_key\", Int64.Type}, {\"metodo_pago_key\", Int64.Type}, {\"TipoComprobante\", type text}, {\"Estado\", type text}, {\"Cantidad\", type number}, {\"PrecioUnitario\", Currency.Type}, {\"Descuento\", Currency.Type}, {\"Importe\", Currency.Type}}),",
                "    Final = Table.SelectColumns(Tipos, {\"item_venta_id\", \"venta_id\", \"fecha_key\", \"Hora\", \"producto_key\", \"cliente_key\", \"metodo_pago_key\", \"TipoComprobante\", \"Estado\", \"Cantidad\", \"PrecioUnitario\", \"Descuento\", \"Importe\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas Totales",
            "expression": "CALCULATE(SUM(Ventas[Importe]), Ventas[Estado] = \"pagada\")",
            "formatString": "\"S/ \"#,0.00"
          },
          {
            "name": "Nro Ventas",
            "expression": "CALCULATE(DISTINCTCOUNT(Ventas[venta_id]), Ventas[Estado] = \"pagada\")",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Promedio",
            "expression": "DIVIDE([Ventas Totales], [Nro Ventas])",
            "formatString": "\"S/ \"#,0.00"
          },
          {
            "name": "Unidades Vendidas",
            "expression": "CALCULATE(SUM(Ventas[Cantidad]), Ventas[Estado] = \"pagada\")",
            "formatString": "#,0"
          },
          {
            "name": "Ventas Anuladas",
            "expression": "CALCULATE(DISTINCTCOUNT(Ventas[venta_id]), Ventas[Estado] = \"anulada\") + 0",
            "formatString": "#,0"
          },
          {
            "name": "% Anulacion",
            "expression": "DIVIDE([Ventas Anuladas], DISTINCTCOUNT(Ventas[venta_id]))",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Producciones",
        "columns": [
          {
