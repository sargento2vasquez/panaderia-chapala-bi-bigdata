            "name": "Total",
            "dataType": "decimal",
            "sourceColumn": "Total",
            "summarizeBy": "none",
            "formatString": "\"S/ \"#,0.00",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Compras",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    T = Origen{[Schema=\"dw\",Item=\"fact_compras\"]}[Data],",
                "    Sel = Table.SelectColumns(T, {\"item_compra_id\", \"compra_id\", \"numero_comprobante\", \"fecha_key\", \"proveedor_key\", \"producto_key\", \"estado\", \"cantidad\", \"costo_unitario\", \"total\"}),",
                "    Ren = Table.RenameColumns(Sel, {{\"numero_comprobante\",\"Comprobante\"}, {\"estado\",\"Estado\"}, {\"cantidad\",\"Cantidad\"}, {\"costo_unitario\",\"CostoUnitario\"}, {\"total\",\"Total\"}}),",
                "    Tipos = Table.TransformColumnTypes(Ren, {{\"item_compra_id\", Int64.Type}, {\"compra_id\", Int64.Type}, {\"Comprobante\", type text}, {\"fecha_key\", Int64.Type}, {\"proveedor_key\", Int64.Type}, {\"producto_key\", Int64.Type}, {\"Estado\", type text}, {\"Cantidad\", type number}, {\"CostoUnitario\", Currency.Type}, {\"Total\", Currency.Type}}),",
                "    Final = Table.SelectColumns(Tipos, {\"item_compra_id\", \"compra_id\", \"Comprobante\", \"fecha_key\", \"proveedor_key\", \"producto_key\", \"Estado\", \"Cantidad\", \"CostoUnitario\", \"Total\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Compras",
            "expression": "CALCULATE(SUM(Compras[Total]), Compras[Estado] <> \"anulada\")",
            "formatString": "\"S/ \"#,0.00"
          },
          {
            "name": "Nro Compras",
            "expression": "CALCULATE(DISTINCTCOUNT(Compras[compra_id]), Compras[Estado] <> \"anulada\")",
            "formatString": "#,0"
          },
          {
            "name": "Proveedores Activos",
            "expression": "CALCULATE(DISTINCTCOUNT(Compras[proveedor_key]), Compras[Estado] <> \"anulada\")",
            "formatString": "#,0"
          }
        ]
      },
