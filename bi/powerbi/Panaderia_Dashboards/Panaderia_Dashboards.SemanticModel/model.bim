    "tables": [
      {
        "name": "Calendario",
        "columns": [
          {
            "name": "fecha_key",
            "dataType": "int64",
            "sourceColumn": "fecha_key",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "MesNum",
            "dataType": "int64",
            "sourceColumn": "MesNum",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "MesNum"
          },
          {
            "name": "DiaSemanaNum",
            "dataType": "int64",
            "sourceColumn": "DiaSemanaNum",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "DiaSemana",
            "dataType": "string",
            "sourceColumn": "DiaSemana",
            "summarizeBy": "none",
            "sortByColumn": "DiaSemanaNum"
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    T = Origen{[Schema=\"dw\",Item=\"dim_fecha\"]}[Data],",
                "    Sel = Table.SelectColumns(T, {\"fecha_key\", \"fecha\", \"anio\", \"mes_num\", \"mes\", \"dia_semana_num\", \"dia_semana\"}),",
                "    Ren = Table.RenameColumns(Sel, {{\"fecha\",\"Fecha\"}, {\"anio\",\"Anio\"}, {\"mes_num\",\"MesNum\"}, {\"mes\",\"Mes\"}, {\"dia_semana_num\",\"DiaSemanaNum\"}, {\"dia_semana\",\"DiaSemana\"}}),",
                "    Tipos = Table.TransformColumnTypes(Ren, {{\"fecha_key\", Int64.Type}, {\"Fecha\", type date}, {\"Anio\", Int64.Type}, {\"MesNum\", Int64.Type}, {\"Mes\", type text}, {\"DiaSemanaNum\", Int64.Type}, {\"DiaSemana\", type text}}),",
                "    Final = Table.SelectColumns(Tipos, {\"fecha_key\", \"Fecha\", \"Anio\", \"MesNum\", \"Mes\", \"DiaSemanaNum\", \"DiaSemana\"})",
                "in",
                "    Final"
              ]
            }
          }
        ]
      },
