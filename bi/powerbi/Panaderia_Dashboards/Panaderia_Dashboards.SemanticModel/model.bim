          },
          {
            "name": "CantidadProgramada",
            "dataType": "double",
            "sourceColumn": "CantidadProgramada",
            "summarizeBy": "sum",
            "formatString": "#,0.###"
          },
          {
            "name": "CantidadObtenida",
            "dataType": "double",
            "sourceColumn": "CantidadObtenida",
            "summarizeBy": "sum",
            "formatString": "#,0.###"
          },
          {
            "name": "MermaCantidad",
            "dataType": "double",
            "sourceColumn": "MermaCantidad",
            "summarizeBy": "sum",
            "formatString": "#,0.###"
          },
          {
            "name": "MotivoMerma",
            "dataType": "string",
            "sourceColumn": "MotivoMerma",
            "summarizeBy": "none"
          },
          {
            "name": "Estado",
            "dataType": "string",
            "sourceColumn": "Estado",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Producciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    T = Origen{[Schema=\"dw\",Item=\"fact_produccion\"]}[Data],",
                "    Sel = Table.SelectColumns(T, {\"produccion_id\", \"referencia\", \"fecha_key\", \"producto_key\", \"cantidad_programada\", \"cantidad_obtenida\", \"merma_cantidad\", \"motivo_merma\", \"estado\"}),",
                "    Ren = Table.RenameColumns(Sel, {{\"referencia\",\"Referencia\"}, {\"cantidad_programada\",\"CantidadProgramada\"}, {\"cantidad_obtenida\",\"CantidadObtenida\"}, {\"merma_cantidad\",\"MermaCantidad\"}, {\"motivo_merma\",\"MotivoMerma\"}, {\"estado\",\"Estado\"}}),",
                "    Tipos = Table.TransformColumnTypes(Ren, {{\"produccion_id\", Int64.Type}, {\"Referencia\", type text}, {\"fecha_key\", Int64.Type}, {\"producto_key\", Int64.Type}, {\"CantidadProgramada\", type number}, {\"CantidadObtenida\", type number}, {\"MermaCantidad\", type number}, {\"MotivoMerma\", type text}, {\"Estado\", type text}}),",
                "    Final = Table.SelectColumns(Tipos, {\"produccion_id\", \"Referencia\", \"fecha_key\", \"producto_key\", \"CantidadProgramada\", \"CantidadObtenida\", \"MermaCantidad\", \"MotivoMerma\", \"Estado\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ordenes Produccion",
            "expression": "CALCULATE(COUNTROWS(Producciones), Producciones[Estado] = \"finalizada\")",
            "formatString": "#,0"
          },
          {
            "name": "Unidades Programadas",
            "expression": "CALCULATE(SUM(Producciones[CantidadProgramada]), Producciones[Estado] = \"finalizada\")",
            "formatString": "#,0"
          },
          {
            "name": "Unidades Obtenidas",
            "expression": "CALCULATE(SUM(Producciones[CantidadObtenida]), Producciones[Estado] = \"finalizada\")",
            "formatString": "#,0"
          },
          {
            "name": "Merma Unidades",
            "expression": "CALCULATE(SUM(Producciones[MermaCantidad]), Producciones[Estado] = \"finalizada\")",
            "formatString": "#,0"
          },
          {
            "name": "% Merma",
            "expression": "DIVIDE([Merma Unidades], [Unidades Programadas])",
            "formatString": "0.0%"
          }
        ]
      },
