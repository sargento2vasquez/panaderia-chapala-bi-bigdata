        ],
        "partitions": [
          {
            "name": "Productos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    T = Origen{[Schema=\"dw\",Item=\"dim_producto\"]}[Data],",
                "    Sel = Table.SelectColumns(T, {\"producto_key\", \"sku\", \"producto\", \"variante\", \"articulo\", \"tipo\", \"categoria\", \"unidad\", \"precio_venta\", \"stock\", \"stock_minimo\", \"estado_stock\", \"activo\"}),",
                "    Ren = Table.RenameColumns(Sel, {{\"sku\",\"SKU\"}, {\"producto\",\"Producto\"}, {\"variante\",\"Variante\"}, {\"articulo\",\"Articulo\"}, {\"tipo\",\"Tipo\"}, {\"categoria\",\"Categoria\"}, {\"unidad\",\"Unidad\"}, {\"precio_venta\",\"PrecioVenta\"}, {\"stock\",\"Stock\"}, {\"stock_minimo\",\"StockMinimo\"}, {\"estado_stock\",\"EstadoStock\"}, {\"activo\",\"Activo\"}}),",
                "    Tipos = Table.TransformColumnTypes(Ren, {{\"producto_key\", Int64.Type}, {\"SKU\", type text}, {\"Producto\", type text}, {\"Variante\", type text}, {\"Articulo\", type text}, {\"Tipo\", type text}, {\"Categoria\", type text}, {\"Unidad\", type text}, {\"PrecioVenta\", Currency.Type}, {\"Stock\", type number}, {\"StockMinimo\", type number}, {\"EstadoStock\", type text}, {\"Activo\", type logical}}),",
                "    Final = Table.SelectColumns(Tipos, {\"producto_key\", \"SKU\", \"Producto\", \"Variante\", \"Articulo\", \"Tipo\", \"Categoria\", \"Unidad\", \"PrecioVenta\", \"Stock\", \"StockMinimo\", \"EstadoStock\", \"Activo\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Nro Productos",
            "expression": "COUNTROWS(Productos)",
            "formatString": "#,0"
          },
          {
            "name": "Stock Actual",
            "expression": "SUM(Productos[Stock])",
            "formatString": "#,0.##"
          },
          {
            "name": "Stock Minimo",
            "expression": "SUM(Productos[StockMinimo])",
            "formatString": "#,0.##"
          },
          {
            "name": "Productos Bajo Minimo",
            "expression": "CALCULATE(COUNTROWS(Productos), Productos[EstadoStock] = \"Bajo mínimo\") + 0",
            "formatString": "#,0"
          },
          {
            "name": "Productos Stock Negativo",
            "expression": "CALCULATE(COUNTROWS(Productos), Productos[EstadoStock] = \"Negativo\") + 0",
            "formatString": "#,0"
          }
        ]
      },
